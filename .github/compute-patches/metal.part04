+            if (bound.sampler == nullptr || bound.sampler->native() == nil) {
+                return false;
+            }
+            entry.gpu_address = bound.sampler->native().gpuResourceID._impl;
+            [retained_samplers_ addObject:bound.sampler->native()];
+            return true;
+        }
+        return false;
